{
  "name": "tomelight",
  "productName": "Tomelight",
  "version": "1.0.0",
  "description": "A beautiful Mac reader and editor for the Markdown and HTML files your AI tools hand you. Tick boxes in place, copy clean for email and social, and shrink images to WebP.",
  "keywords": [
    "markdown",
    "markdown-reader",
    "markdown-editor",
    "html-viewer",
    "electron",
    "macos",
    "webp",
    "image-optimizer",
    "checklist",
    "ai"
  ],
  "homepage": "https://github.com/aiprofitwire/tomelight#readme",
  "bugs": {
    "url": "https://github.com/aiprofitwire/tomelight/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiprofitwire/tomelight.git"
  },
  "license": "MIT",
  "author": "Moe Sbaiti",
  "main": "src/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "test": "node --test \"test/*.test.mjs\"",
    "package": "node build.mjs && node scripts/package.mjs",
    "package:x64": "node build.mjs && node scripts/package.mjs --x64"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@electron/packager": "^20.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
